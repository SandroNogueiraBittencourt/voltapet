# Crie .env a partir deste arquivo e configure senhas exclusivas.
# Gerar JWT_SECRET: openssl rand -hex 32
# Gerar as senhas: openssl rand -base64 24
DB_NAME=voltapet
DB_USER=voltapet
DB_PASSWORD=
DB_PORT=5432
JWT_SECRET=
JWT_EXPIRATION_MS=86400000
S3_BUCKET=voltapet-images
S3_ACCESS_KEY=voltapet
S3_SECRET_KEY=
S3_PORT=9000
S3_CONSOLE_PORT=9001
BACKEND_PORT=8080
